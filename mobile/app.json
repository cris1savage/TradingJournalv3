{
  "expo": {
    "name": "TJ Pro",
    "slug": "trading-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tradingjournal",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#07090E",
    "ios": {
      "bundleIdentifier": "com.tjpro.tradingjournal",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tjpro.tradingjournal",
      "adaptiveIcon": {
        "backgroundColor": "#07090E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TJ Pro usa Face ID para proteger tus datos de trading cuando activas el bloqueo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3D7BFF"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TJBalance",
              "displayName": "TJ Pro · Balance",
              "description": "Tu balance total y el P&L de hoy y del mes.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/BalanceWidget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "tradingjournal-app",
    "extra": {
      "eas": {
        "projectId": "45c7f1b5-67ea-40eb-9972-30778bae1a82"
      }
    }
  }
}
